<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
  ============================================================
  HeelonVault - MSI Installer Template
  ============================================================
  -->

  <!-- ==========================================================
       Product Configuration
       ========================================================== -->

  <Product
      Id="*"
      Name="HeelonVault"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="ppaperso"
      UpgradeCode="B0C8A091-55B8-4101-A510-119779831DFD">

    <Package
        Description="HeelonVault - Gestionnaire de mots de passe sécurisé"
        Comments="HeelonVault"
        Manufacturer="ppaperso"
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64" />

    <!-- Upgrade / uninstall of previous versions -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="Une version plus récente de HeelonVault est déjà installée." />

    <!-- ==========================================================
         Application Icon
         ========================================================== -->

    <Icon
        Id="HeelonVaultIcon"
        SourceFile="wix\Heelonys.ico" />

    <!-- Icon displayed by Windows in Apps & Features -->
    <Property
        Id="ARPPRODUCTICON"
        Value="HeelonVaultIcon" />

    <!-- Installation directory displayed by Windows -->
    <Property
        Id="ARPINSTALLLOCATION"
        Value="INSTALLFOLDER" />

    <!-- Project/help page -->
    <Property
        Id="ARPHELPLINK"
        Value="https://github.com/ppaperso/heelonvault-core" />

    <!-- ==========================================================
         Directory Tree
         ========================================================== -->

    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Windows Program Files -->
      <Directory Id="ProgramFilesFolder">

        <Directory
            Id="INSTALLFOLDER"
            Name="HeelonVault">

          <!-- Main executable -->
          <Component
              Id="ApplicationExecutable"
              Guid="*">

            <File
                Id="HeelonVaultExe"
                Name="heelonvault.exe"
                Source="$(var.CargoTargetBinDir)\heelonvault.exe"
                KeyPath="yes" />

          </Component>

          <!-- DLL Directory -->
          <Directory Id="DLLFolder" Name="dlls">
            <Component Id="GTKDLLs" Guid="*">
              <RemoveFolder Id="RemoveDLLFolder" Directory="DLLFolder" On="uninstall" />
            </Component>
          </Directory>

          <!-- Assets Directory -->
          <Directory Id="AssetsFolder" Name="assets">
            <Component Id="Assets" Guid="*">
              <RemoveFolder Id="RemoveAssetsFolder" Directory="AssetsFolder" On="uninstall" />
            </Component>
          </Directory>

          <!-- Locales Directory -->
          <Directory Id="LocalesFolder" Name="locales">
            <Component Id="Locales" Guid="*">
              <RemoveFolder Id="RemoveLocalesFolder" Directory="LocalesFolder" On="uninstall" />
            </Component>
          </Directory>

          <!-- Migrations Directory -->
          <Directory Id="MigrationsFolder" Name="migrations">
            <Component Id="Migrations" Guid="*">
              <RemoveFolder Id="RemoveMigrationsFolder" Directory="MigrationsFolder" On="uninstall" />
            </Component>
          </Directory>

          <!-- Resources Directory -->
          <Directory Id="ResourcesFolder" Name="resources">
            <Component Id="Resources" Guid="*">
              <RemoveFolder Id="RemoveResourcesFolder" Directory="ResourcesFolder" On="uninstall" />
            </Component>
          </Directory>

        </Directory>

      </Directory>

      <!-- Start Menu Shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="HeelonVault">
          <Component Id="StartMenuShortcut" Guid="*">
            <Shortcut
                Id="StartMenuShortcut"
                Name="HeelonVault"
                Description="Lancer HeelonVault"
                Target="[INSTALLFOLDER]heelonvault.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="HeelonVaultIcon"
                IconIndex="0" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKLM" Key="Software\HeelonVault" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Desktop Shortcut -->
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="*">
          <Shortcut
              Id="DesktopShortcut"
              Name="HeelonVault"
              Description="Lancer HeelonVault"
              Target="[INSTALLFOLDER]heelonvault.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="HeelonVaultIcon"
              IconIndex="0" />
          <RemoveFolder Id="RemoveDesktopShortcut" Directory="DesktopFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\HeelonVault" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>

    </Directory>

    <!-- Features -->
    <Feature
        Id="MainFeature"
        Title="HeelonVault"
        Description="HeelonVault Application"
        Level="1"
        Display="expand"
        Absent="disallow">
      <ComponentRef Id="ApplicationExecutable" />
      <ComponentRef Id="GTKDLLs" />
      <ComponentRef Id="Assets" />
      <ComponentRef Id="Locales" />
      <ComponentRef Id="Migrations" />
      <ComponentRef Id="Resources" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Standard MSI UI -->
    <UIRef Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="" />
    <WixVariable Id="WixUIBannerBmp" Value="" />
    <WixVariable Id="WixUIDialogBmp" Value="" />

</Wix>
