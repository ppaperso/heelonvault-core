<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!-- ============================================================
       Product
       ============================================================ -->

  <Product
      Id="*"
      Name="HeelonVault"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="ppaperso"
      UpgradeCode="B0C8A091-55B8-4101-A510-119779831DFD">

    <Package
        Description="HeelonVault — Gestionnaire de mots de passe sécurisé"
        Comments="HeelonVault"
        Manufacturer="ppaperso"
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64" />

    <!-- Upgrade / uninstall of previous versions -->
    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="Une version plus récente de HeelonVault est déjà installée." />

    <!-- ==========================================================
         Application icon
         ========================================================== -->

    <Icon
        Id="HeelonVaultIcon"
        SourceFile="wix\staging\heelonvault.ico" />

    <!-- Icon displayed by Windows in Apps & Features -->
    <Property
        Id="ARPPRODUCTICON"
        Value="HeelonVaultIcon" />

    <!-- Installation directory displayed by Windows -->
    <Property
        Id="ARPINSTALLLOCATION"
        Value="INSTALLFOLDER" />

    <!-- Project/help page -->
    <Property
        Id="ARPHELPLINK"
        Value="https://github.com/ppaperso/heelonvault-core" />

    <!-- ==========================================================
         Directory tree
         ========================================================== -->

    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Windows Program Files -->
      <Directory Id="ProgramFilesFolder">

        <Directory
            Id="INSTALLFOLDER"
            Name="HeelonVault">

          <!-- Main executable -->
          <Component
              Id="ApplicationExecutable"
              Guid="*">
            <File
                Id="HeelonVaultExe"
                Name="heelonvault.exe"
                Source="wix\staging\heelonvault.exe"
                KeyPath="yes" />
          </Component>

          <!-- Reference to auto-generated staging components -->
          <ComponentGroupRef Id="StagingComponents" />

          <!-- ======================================================
               Migrations
               ====================================================== -->

          <Directory
              Id="MigrationsFolder"
              Name="migrations">
            <!-- Files included via StagingComponents -->
          </Directory>

        </Directory>

      </Directory>

      <!-- ==========================================================
           Start Menu
           ========================================================== -->

      <Directory
          Id="ProgramMenuFolder">

        <Directory
            Id="ApplicationProgramsFolder"
            Name="HeelonVault">

          <Component
              Id="StartMenuShortcut"
              Guid="*">

            <Shortcut
                Id="StartMenuShortcut"
                Name="HeelonVault"
                Description="Lancer HeelonVault"
                Target="[INSTALLFOLDER]heelonvault.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="HeelonVaultIcon"
                IconIndex="0" />

            <RemoveFolder
                Id="RemoveApplicationProgramsFolder"
                Directory="ApplicationProgramsFolder"
                On="uninstall" />

            <RegistryValue
                Root="HKLM"
                Key="Software\HeelonVault"
                Name="StartMenuShortcut"
                Type="integer"
                Value="1"
                KeyPath="yes" />

          </Component>

        </Directory>

      </Directory>

      <!-- ==========================================================
           Desktop
           ========================================================== -->

      <Directory
          Id="DesktopFolder">

        <Component
            Id="DesktopShortcut"
            Guid="*">

          <Shortcut
              Id="DesktopShortcut"
              Name="HeelonVault"
              Description="Lancer HeelonVault"
              Target="[INSTALLFOLDER]heelonvault.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="HeelonVaultIcon"
              IconIndex="0" />

          <RegistryValue
              Root="HKLM"
              Key="Software\HeelonVault"
              Name="DesktopShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />

        </Component>

      </Directory>

    </Directory>

    <!-- ============================================================
         Features
         ============================================================ -->

    <Feature
        Id="MainFeature"
        Title="HeelonVault"
        Description="HeelonVault application"
        Level="1"
        Display="expand"
        Absent="disallow">

      <ComponentRef Id="ApplicationExecutable" />
      <ComponentGroupRef Id="StagingComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />

    </Feature>

    <!-- ============================================================
         Standard MSI UI
         ============================================================ -->

    <UIRef Id="WixUI_FeatureTree" />

    <WixVariable
        Id="WixUILicenseRtf"
        Value="" />

    <WixVariable
        Id="WixUIBannerBmp"
        Value="" />

    <WixVariable
        Id="WixUIDialogBmp"
        Value="" />

  </Product>

</Wix>
