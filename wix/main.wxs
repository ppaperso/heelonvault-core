<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!-- ============================================================
       Product
       ============================================================ -->

<Product
   Id="*"
   Name="HeelonVault"
   Language="1033"
   Version="$(var.Version)"
   Manufacturer="ppaperso"
   UpgradeCode="B0C8A091-55B8-4101-A510-119779831DFD">

<Package
    Description="HeelonVault — Binaire GTK4/Libadwaita"
    Comments="HeelonVault"
    Manufacturer="ppaperso"
    InstallerVersion="500"
    Compressed="yes"
    InstallScope="perMachine" />

<!-- Upgrade / uninstall of previous versions -->
<MajorUpgrade
    Schedule="afterInstallInitialize"
    DowngradeErrorMessage="Une version plus récente de HeelonVault est déjà installée." />

<!-- ==========================================================
     Application icon
     ========================================================== -->

<Icon
    Id="HeelonVaultIcon"
    SourceFile="wix\heelonvault.ico" />

<!-- Icon displayed by Windows in Apps & Features -->
<Property
    Id="ARPPRODUCTICON"
    Value="HeelonVaultIcon" />

<!-- Installation directory displayed by Windows -->
<Property
    Id="ARPINSTALLLOCATION"
    Value="INSTALLFOLDER" />

<!-- Project/help page -->
<Property
    Id="ARPHELPLINK"
    Value="https://github.com/ppaperso/heelonvault-core" />

<!-- ==========================================================
     Directory tree
     ========================================================== -->

<Directory Id="TARGETDIR" Name="SourceDir">

  <!-- Windows Program Files -->
  <Directory Id="ProgramFilesFolder">

    <Directory
        Id="INSTALLFOLDER"
        Name="HeelonVault">

      <!-- Main executable -->
      <Component
          Id="ApplicationExecutable"
          Guid="*">

        <File
            Id="HeelonVaultExe"
            Name="heelonvault.exe"
            Source="$(var.CargoTargetBinDir)\heelonvault.exe"
            KeyPath="yes" />

      </Component>

      <!-- ======================================================
           Migrations
           ====================================================== -->

      <Directory
          Id="MigrationsFolder"
          Name="migrations">

        <Component Id="Migration0001" Guid="*">
          <File Id="MigrationFile0001"
                Name="0001_init_schema.sql"
                Source="..\..\migrations\0001_init_schema.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0002" Guid="*">
          <File Id="MigrationFile0002"
                Name="0002_db_metadata_schema_version.sql"
                Source="..\..\migrations\0002_db_metadata_schema_version.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0003" Guid="*">
          <File Id="MigrationFile0003"
                Name="0003_secret_item_extensions.sql"
                Source="..\..\migrations\0003_secret_item_extensions.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0004" Guid="*">
          <File Id="MigrationFile0004"
                Name="0004_user_profile_fields.sql"
                Source="..\..\migrations\0004_user_profile_fields.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0005" Guid="*">
          <File Id="MigrationFile0005"
                Name="0005_auth_policy.sql"
                Source="..\..\migrations\0005_auth_policy.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0006" Guid="*">
          <File Id="MigrationFile0006"
                Name="0006_auth_policy_auto_lock_delay.sql"
                Source="..\..\migrations\0006_auth_policy_auto_lock_delay.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0007" Guid="*">
          <File Id="MigrationFile0007"
                Name="0007_login_history.sql"
                Source="..\..\migrations\0007_login_history.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0008" Guid="*">
          <File Id="MigrationFile0008"
                Name="0008_user_show_passwords_in_edit.sql"
                Source="..\..\migrations\0008_user_show_passwords_in_edit.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0009" Guid="*">
          <File Id="MigrationFile0009"
                Name="0009_user_totp_secret.sql"
                Source="..\..\migrations\0009_user_totp_secret.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0010" Guid="*">
          <File Id="MigrationFile0010"
                Name="0010_user_preferred_language.sql"
                Source="..\..\migrations\0010_user_preferred_language.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0011" Guid="*">
          <File Id="MigrationFile0011"
                Name="0011_teams.sql"
                Source="..\..\migrations\0011_teams.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0012" Guid="*">
          <File Id="MigrationFile0012"
                Name="0012_vault_key_shares.sql"
                Source="..\..\migrations\0012_vault_key_shares.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0013" Guid="*">
          <File Id="MigrationFile0013"
                Name="0013_audit_log.sql"
                Source="..\..\migrations\0013_audit_log.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0014" Guid="*">
          <File Id="MigrationFile0014"
                Name="0014_vault_security_rbac.sql"
                Source="..\..\migrations\0014_vault_security_rbac.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0015" Guid="*">
          <File Id="MigrationFile0015"
                Name="0015_vault_sort_order.sql"
                Source="..\..\migrations\0015_vault_sort_order.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0016" Guid="*">
          <File Id="MigrationFile0016"
                Name="0016_ip_rate_limiting.sql"
                Source="..\..\migrations\0016_ip_rate_limiting.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0017" Guid="*">
          <File Id="MigrationFile0017"
                Name="0017_user_recovery_phrase.sql"
                Source="..\..\migrations\0017_user_recovery_phrase.sql"
                KeyPath="yes" />
        </Component>

        <Component Id="Migration0018" Guid="*">
          <File Id="MigrationFile0018"
                Name="0018_user_recovery_verifier.sql"
                Source="..\..\migrations\0018_user_recovery_verifier.sql"
                KeyPath="yes" />
        </Component>

      </Directory>

    </Directory>

  </Directory>

  <!-- ==========================================================
       Start Menu
       ========================================================== -->

  <Directory
      Id="ProgramMenuFolder">

    <Directory
        Id="ApplicationProgramsFolder"
        Name="HeelonVault">

      <Component
          Id="StartMenuShortcut"
          Guid="*">

        <Shortcut
            Id="StartMenuShortcut"
            Name="HeelonVault"
            Description="Lancer HeelonVault"
            Target="[INSTALLFOLDER]heelonvault.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="HeelonVaultIcon"
            IconIndex="0" />

        <RemoveFolder
            Id="RemoveApplicationProgramsFolder"
            Directory="ApplicationProgramsFolder"
            On="uninstall" />

        <RegistryValue
            Root="HKLM"
            Key="Software\HeelonVault"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />

      </Component>

    </Directory>

  </Directory>

  <!-- ==========================================================
       Desktop
       ========================================================== -->

  <Directory
      Id="DesktopFolder">

    <Component
        Id="DesktopShortcut"
        Guid="*">

      <Shortcut
          Id="DesktopShortcut"
          Name="HeelonVault"
          Description="Lancer HeelonVault"
          Target="[INSTALLFOLDER]heelonvault.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="HeelonVaultIcon"
          IconIndex="0" />

      <RegistryValue
          Root="HKLM"
          Key="Software\HeelonVault"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />

    </Component>

  </Directory>

</Directory>

<!-- ============================================================
     Features
     ============================================================ -->

<Feature
    Id="MainFeature"
    Title="HeelonVault"
    Description="HeelonVault application"
    Level="1"
    Display="expand"
    Absent="disallow">

  <ComponentRef Id="ApplicationExecutable" />

  <ComponentRef Id="Migration0001" />
  <ComponentRef Id="Migration0002" />
  <ComponentRef Id="Migration0003" />
  <ComponentRef Id="Migration0004" />
  <ComponentRef Id="Migration0005" />
  <ComponentRef Id="Migration0006" />
  <ComponentRef Id="Migration0007" />
  <ComponentRef Id="Migration0008" />
  <ComponentRef Id="Migration0009" />
  <ComponentRef Id="Migration0010" />
  <ComponentRef Id="Migration0011" />
  <ComponentRef Id="Migration0012" />
  <ComponentRef Id="Migration0013" />
  <ComponentRef Id="Migration0014" />
  <ComponentRef Id="Migration0015" />
  <ComponentRef Id="Migration0016" />
  <ComponentRef Id="Migration0017" />
  <ComponentRef Id="Migration0018" />

  <ComponentRef Id="StartMenuShortcut" />
  <ComponentRef Id="DesktopShortcut" />

</Feature>

<!-- ============================================================
     Standard MSI UI
     ============================================================ -->

<UIRef Id="WixUI_FeatureTree" />

<WixVariable
    Id="WixUILicenseRtf"
    Value="" />

<WixVariable
    Id="WixUIBannerBmp"
    Value="" />

<WixVariable
    Id="WixUIDialogBmp"
    Value="" />

  </Product>

</Wix>
